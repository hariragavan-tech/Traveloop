<record id="view_travel_trip_kanban" model="ir.ui.view">
    <field name="name">travel.trip.kanban</field>
    <field name="model">travel.trip</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" sample="1">
            <field name="name"/>
            <field name="total_budget"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>Budget: <field name="total_budget" widget="monetary"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>git checkout feature/frontend-ui